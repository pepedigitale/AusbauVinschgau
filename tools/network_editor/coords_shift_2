from inspect import trace
import csv, json, math
from pathlib import Path

INPUT_JSON = "vinschgau.json.txt"
INPUT_CSV = "nodes_copy.csv"
OUTPUT_CSV = "nodes.csv"

SIDE_OFFSET_M = 5.0

METERS_PER_DEG_LAT = 111138.0
METERS_PER_DEG_LON = 76300.0


def load_trace(filename):
    with open(filename, encoding="utf-8") as f:
        data = json.load(f)

    relation = next(e for e in data["elements"] if e["type"] == "relation")
    ways = [m["geometry"] for m in relation["members"]
            if m["type"] == "way" and m.get("geometry")]

    def key(p):
        return round(p["lat"], 9), round(p["lon"], 9)

    # Start at the eastern/Meran end.
    first_i = max(range(len(ways)), key=lambda i: max(p["lon"] for p in ways[i]))
    trace = ways.pop(first_i)

    while ways:
        end = key(trace[-1])
        found = None

        for i, way in enumerate(ways):
            if key(way[0]) == end:
                found = (i, way)
                break
            if key(way[-1]) == end:
                found = (i, list(reversed(way)))
                break

        if found is None:
            raise RuntimeError("Could not stitch all OSM ways together.")

        i, way = found
        ways.pop(i)
        trace.extend(way[1:])

    return trace


def xy(lat, lon, lat0, lon0):
    return (lon - lon0) * METERS_PER_DEG_LON, (lat - lat0) * METERS_PER_DEG_LAT


def build_trace(trace):
    lat0 = trace[0]["lat"]
    lon0 = trace[0]["lon"]

    points = [xy(p["lat"], p["lon"], lat0, lon0) for p in trace[1:]]
    points += [xy(p["lat"], p["lon"], lat0, lon0) for p in trace[1:]]

    distances = [0.0]

    for a, b in zip(points, points[1:]):
        distances.append(distances[-1] + math.hypot(b[0] - a[0], b[1] - a[1]))

    return points, distances, lat0, lon0


def point_at_distance(points, distances, distance):
    distance = max(0.0, min(distance, distances[-1]))

    for i in range(len(points) - 1):
        d1, d2 = distances[i], distances[i + 1]

        if d1 <= distance <= d2:
            x1, y1 = points[i]
            x2, y2 = points[i + 1]

            dx, dy = x2 - x1, y2 - y1
            length = math.hypot(dx, dy)

            if length == 0:
                continue

            t = (distance - d1) / (d2 - d1)

            x = x1 + t * dx
            y = y1 + t * dy

            # Tangent in Meran -> Malles direction.
            tx = dx / length
            ty = dy / length

            return x, y, tx, ty

    raise RuntimeError("Could not determine position on trace.")


def parse_float(value):
    return float(value.strip().replace(",", "."))


def main():
    base = Path(__file__).resolve().parent
    json_path = base / INPUT_JSON
    csv_path = base / INPUT_CSV
    output_path = base / OUTPUT_CSV

    print(f"Loading main trace: {json_path}")

    trace = load_trace(json_path)
    points, distances, lat0, lon0 = build_trace(trace)

    print(f"Trace points: {len(points)}")
    print(f"Trace length: {distances[-1]:.1f} m")

    with open(csv_path, encoding="utf-8-sig", newline="") as f:
        reader = csv.DictReader(f, delimiter=";")
        fieldnames = reader.fieldnames
        rows = list(reader)

    shifted = 0

    for row in rows:
        y_value = parse_float(row["y"])

        if y_value == 0:
            continue

        pk_rel = parse_float(row["pk_rel"])
        distance = pk_rel * 1000.0

        x, y, tx, ty = point_at_distance(
            points, distances, distance
        )

        # Left of the Meran -> Malles direction.
        left_x = -ty
        left_y = tx

        offset = y_value * SIDE_OFFSET_M

        x += offset * left_x
        y += offset * left_y

        # Convert metres back to longitude/latitude.
        row["coord_x"] = f"{lon0 + x / METERS_PER_DEG_LON:.8f}"
        row["coord_y"] = f"{lat0 + y / METERS_PER_DEG_LAT:.8f}"

        shifted += 1

    with open(output_path, "w", encoding="utf-8", newline="") as f:
        writer = csv.DictWriter(
            f,
            fieldnames=fieldnames,
            delimiter=";",
            lineterminator="\n"
        )
        writer.writeheader()
        writer.writerows(rows)

    print(f"Shifted {shifted} nodes.")
    print(f"Output: {output_path}")


if __name__ == "__main__":
    main()